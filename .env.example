CONTENTFUL_SPACE_ID=
CONTENTFUL_ACCESS_TOKEN=
CONTENTFUL_ENVIRONMENT=master

# Optional: build against the Preview API (draft + published content)
# instead of the Content Delivery API (published only). Requires a
# separate Preview API access token from Contentful, not the CDA token above.
# CONTENTFUL_PREVIEW=true
# CONTENTFUL_PREVIEW_ACCESS_TOKEN=
